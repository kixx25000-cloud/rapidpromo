# Copiez ce fichier en ".env" et remplissez les valeurs.

# Port d'écoute du serveur
PORT=3000

# Identifiants pour accéder à l'espace d'administration (/admin)
ADMIN_USER=admin
ADMIN_PASS=changez-moi

# Jeton secret à fournir pour déclencher un import manuellement via
# GET /api/cron/import?token=CE_JETON  (utilisé par un cron externe en production)
CRON_TOKEN=changez-moi-aussi

# Toutes les combien d'heures le site relance automatiquement un import
# tant que le serveur tourne (voir README pour les alternatives en production)
IMPORT_INTERVAL_HOURS=6
